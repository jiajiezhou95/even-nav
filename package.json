{
  "name": "even-nav",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite apps/even-nav --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:imports": "vitest run packages/core/src/import",
    "test:ui": "playwright test",
    "build": "vite build apps/even-nav --outDir ../../dist",
    "doctor": "tsx scripts/doctor.ts",
    "pack": "tsx scripts/pack.ts",
    "privacy:check": "tsx scripts/privacy-check.ts",
    "cost:estimate": "tsx scripts/cost-estimate.ts",
    "replay": "tsx scripts/replay.ts",
    "probe:providers": "tsx scripts/probe-providers.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.toml --outdir artifacts/worker",
    "probe:transit": "tsx scripts/probe-transit.ts",
    "probe:links": "tsx scripts/public-links.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "latest",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@evenrealities/evenhub-cli": "latest",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "node": "^22.23.3",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
